# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# From Supabase: Project Settings -> Database -> Connection string ->
# "Transaction pooler" (recommended for serverless — it's the one on
# port 6543). Replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# A long random string used to sign login session cookies. Generate one
# with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
